root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf

[*.{cs}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,targets}]
indent_style = space
indent_size = 2

[*.ps1]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
